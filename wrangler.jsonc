{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hugo-tailwindcss-starter",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "pnpm build",
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
  },
}
