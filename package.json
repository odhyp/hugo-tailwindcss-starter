{
  "name": "hugo-tailwindcss-starter",
  "version": "1.3.0",
  "description": "Minimal Hugo starter with Tailwind CSS v4 and Prettier, ready to deploy in Cloudflare Workers.",
  "scripts": {
    "dev": "hugo server --buildDrafts --buildFuture",
    "build": "hugo --gc --minify",
    "preview": "hugo server --minify",
    "new": "hugo new content",
    "deploy": "wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "hugo",
    "tailwindcss",
    "cloudflare",
    "starter",
    "template"
  ],
  "author": "Odhy Pradhana <hi@odhyp.com>",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "devDependencies": {
    "@htnabe/prettier-plugin-go-template": "^0.0.6",
    "@htnabe/prettier-plugin-hugo-post": "^0.0.2",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "prettier": "3.9.10",
    "prettier-plugin-toml": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.156.1"
  }
}
